{
  "info": {
    "name": "Employee Management API",
    "description": "Requests and tests for the Employee Management API (independent demonstration project). Set baseUrl to the running API.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5080"
    },
    {
      "key": "employeeId",
      "value": ""
    },
    {
      "key": "departmentId",
      "value": ""
    },
    {
      "key": "testEmail",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health check",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Departments",
      "item": [
        {
          "name": "List departments",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/departments",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "departments"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 and an array', () => { pm.response.to.have.status(200); pm.expect(pm.response.json()).to.be.an('array').that.is.not.empty; });"
                ]
              }
            }
          ]
        },
        {
          "name": "Create department",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/departments",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "departments"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Legal {{$timestamp}}\",\n  \"location\": \"Dubai\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('departmentId', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Update department",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/departments/{{departmentId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "departments",
                "{{departmentId}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Legal & Compliance {{$timestamp}}\",\n  \"location\": \"Abu Dhabi\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('location updated', () => pm.expect(pm.response.json().location).to.eql('Abu Dhabi'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Delete department with staff is blocked",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/departments/1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "departments",
                "1"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('409 Conflict', () => pm.response.to.have.status(409));"
                ]
              }
            }
          ]
        },
        {
          "name": "Delete empty department",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/departments/{{departmentId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "departments",
                "{{departmentId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('204 No Content', () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Employees",
      "item": [
        {
          "name": "List employees (paged, filtered)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/employees?departmentId=1&page=1&pageSize=2&sort=-salary",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "employees"
              ],
              "query": [
                {
                  "key": "departmentId",
                  "value": "1"
                },
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "pageSize",
                  "value": "2"
                },
                {
                  "key": "sort",
                  "value": "-salary"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const b = pm.response.json();",
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('page size respected', () => pm.expect(b.items.length).to.be.at.most(2));",
                  
                  "pm.test('has paging metadata', () => pm.expect(b).to.include.keys('totalCount','totalPages'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Create employee",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/employees",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "employees"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Postman\",\n  \"lastName\": \"Tester\",\n  \"email\": \"{{testEmail}}\",\n  \"phone\": \"+971501234567\",\n  \"jobTitle\": \"QA Engineer\",\n  \"hireDate\": \"2026-03-01\",\n  \"monthlySalary\": 11000,\n  \"departmentId\": 1,\n  \"managerId\": 2,\n  \"status\": \"Active\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "pm.test('Location header', () => pm.response.to.have.header('Location'));",
                  "pm.collectionVariables.set('employeeId', pm.response.json().id);"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('testEmail', `postman.${Date.now()}@example.com`);"
                ]
              }
            }
          ]
        },
        {
          "name": "Get employee",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/employees/{{employeeId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "employees",
                "{{employeeId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('manager name resolved', () => pm.expect(pm.response.json().managerName).to.eql('Rahul Nair'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Create employee with invalid data",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
