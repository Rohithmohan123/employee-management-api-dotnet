            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"\",\n  \"email\": \"not-an-email\",\n  \"monthlySalary\": 5,\n  \"departmentId\": 0\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('400 with field errors', () => { pm.response.to.have.status(400); pm.expect(pm.response.json().errors).to.have.property('Email'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Create employee with duplicate email",
