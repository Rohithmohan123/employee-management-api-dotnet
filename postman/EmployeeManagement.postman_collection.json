          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('assignment listed', () => pm.expect(pm.response.json().projects.map(p => p.projectCode)).to.include('ENG-PORTAL'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Over-allocation is rejected",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
