            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Postman\",\n  \"lastName\": \"Tester\",\n  \"email\": \"{{testEmail}}\",\n  \"phone\": \"+971501234567\",\n  \"jobTitle\": \"QA Engineer\",\n  \"hireDate\": \"2026-03-01\",\n  \"monthlySalary\": 12000,\n  \"departmentId\": 1,\n  \"managerId\": 2,\n  \"status\": \"OnLeave\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
